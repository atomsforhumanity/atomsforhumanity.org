---
const stages = ["Hypothesize", "Simulate", "Analyze", "Learn"];
const experiments = ["EXPERIMENT 001", "EXPERIMENT 002", "EXPERIMENT 003", "EXPERIMENT N"];
---

<figure class="scale-workflow surface--paper">
  <header>
    <span>DIGITAL LABORATORY</span>
    <span>SCIENTIFIC WORKFLOW</span>
  </header>

  <ol class="workflow-stages" aria-label="Scientific workflow">
    {stages.map((stage, index) => (
      <li class="workflow-stage">
        <span>0{index + 1}</span>
        <strong>{stage}</strong>
      </li>
    ))}
  </ol>

  <div class="scale-heading">
    <strong>AT SCALE</strong>
    <span>Many computational experiments in parallel</span>
  </div>

  <div class="experiment-field" role="group" aria-label="The workflow is distributed across many parallel computational experiments">
    {experiments.map((experiment, experimentIndex) => (
      <div class:list={["experiment-lane", { "experiment-lane--continuing": experimentIndex === experiments.length - 1 }]}>
        <span>{experiment}</span>
        <div class="lane-stages" aria-hidden="true">
          {stages.map((_, stageIndex) => <i style={`--stage: ${stageIndex}`}></i>)}
        </div>
      </div>
    ))}
  </div>

  <figcaption>The same rigorous workflow, distributed across many computational experiments.</figcaption>
</figure>

<style>
  .scale-workflow { color: var(--text-primary); margin: 0; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--bg-secondary); border-radius: var(--radius-md); }
  header { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); color: var(--text-muted); font: 600 .7rem/1.4 var(--font-sans); letter-spacing: .05em; }
  .workflow-stages { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 1.75rem 0 0; padding: 0; }
  .workflow-stage { position: relative; padding: 0 0 1rem; border-bottom: 2px solid var(--blue-light); }
  .workflow-stage:not(:last-child)::after { position: absolute; inset: auto -.8rem 1rem auto; content: "→"; color: var(--blue-primary); font: 500 .9rem/1 var(--font-sans); }
  .workflow-stage span { display: block; margin-bottom: 1.4rem; color: var(--text-muted); font: 500 .75rem/1 var(--font-sans); }
  .workflow-stage strong { display: block; font: 600 .9rem/1.25 var(--font-sans); }
  .scale-heading { display: flex; align-items: baseline; gap: 1rem; margin-top: 2.25rem; padding-bottom: .8rem; border-bottom: 1px solid var(--border); }
  .scale-heading strong { flex: none; color: var(--blue-primary); font: 600 .82rem/1 var(--font-sans); letter-spacing: .06em; }
  .scale-heading span { color: var(--text-secondary); font-size: .92rem; }
  .experiment-field { padding-top: .75rem; }
  .experiment-lane { display: grid; grid-template-columns: 108px 1fr; align-items: center; gap: 1rem; min-height: 39px; }
  .experiment-lane > span { color: var(--text-muted); font: 500 .7rem/1.2 var(--font-sans); letter-spacing: .025em; }
  .lane-stages { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); align-items: center; gap: 4px; }
  .lane-stages::before { content: ""; position: absolute; top: 50%; left: 5px; right: calc(25% - 5px); border-top: 1px solid var(--diagram-line); }
  .lane-stages i { z-index: 1; width: 9px; height: 9px; background: var(--bg-secondary); border: 1.5px solid var(--blue-primary); border-radius: 50%; }
  .lane-stages i:last-child { border-color: var(--green-dark); }
  .experiment-lane--continuing { margin-top: .3rem; padding-top: .55rem; border-top: 1px dashed var(--border); }
  .experiment-lane--continuing .lane-stages::before { border-top-style: dashed; }
  figcaption { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--text-muted); font: 400 .9rem/1.5 var(--font-sans); }
  @media (max-width: 540px) {
    header span:last-child { text-align: right; }
    .workflow-stages { grid-template-columns: 1fr; gap: .5rem; }
    .workflow-stage { display: flex; align-items: center; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid var(--border); }
    .workflow-stage span { margin: 0; }
    .workflow-stage strong { font-size: 1rem; }
    .workflow-stage:not(:last-child)::after { inset: auto .5rem -.7rem auto; transform: rotate(90deg); }
    .scale-heading { align-items: flex-start; flex-direction: column; gap: .5rem; }
  }
</style>
