---
interface Props { items: string[]; caption: string; }
const { items, caption } = Astro.props;
---

<figure class="process-loop">
  <ol style={`--process-count: ${items.length}`}>
    {items.map((item, index) => (
      <li>
        <span class="process-number">{String(index + 1).padStart(2, "0")}</span>
        <strong>{item}</strong>
        {index < items.length - 1 && <span class="process-arrow" aria-hidden="true">→</span>}
      </li>
    ))}
  </ol>
  <div class="return-line" aria-hidden="true"><span>↺</span></div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .process-loop { margin: 3.5rem 0 0; padding: clamp(1.5rem, 4vw, 3rem); background: var(--bg-elevated); border: 1px solid var(--border-dark); border-radius: var(--radius-md); }
  ol { list-style: none; display: grid; grid-template-columns: repeat(var(--process-count, 5), 1fr); padding: 0; margin: 0; }
  li { position: relative; display: flex; min-height: 125px; flex-direction: column; justify-content: space-between; padding: 0 2.4rem 0 0; }
  li + li { padding-left: 1.3rem; border-left: 1px solid var(--border-dark); }
  .process-number { color: var(--accent); font: 500 .68rem/1 var(--font-mono); }
  strong { font-weight: 500; line-height: 1.3; letter-spacing: -.025em; }
  .process-arrow { position: absolute; inset: 50% .55rem auto auto; color: var(--text-muted); font-family: var(--font-mono); }
  .return-line { height: 28px; margin-top: 1.2rem; border: solid rgba(66,221,177,.28); border-width: 0 1px 1px; text-align: left; }
  .return-line span { position: relative; top: 12px; left: -5px; color: var(--accent); background: var(--bg-elevated); }
  figcaption { margin-top: 1.5rem; max-width: 800px; color: var(--text-secondary); font-size: .9rem; }
  @media (max-width: 850px) { ol { grid-template-columns: 1fr; }li, li + li { min-height: auto; padding: 1.1rem 2.5rem 1.1rem 0; border-left: 0; border-top: 1px solid var(--border-dark); flex-direction: row; justify-content: flex-start; gap: 1.3rem; }.process-arrow { inset: auto 1rem -11px auto; transform: rotate(90deg); }.return-line { display: none; } }
</style>
