---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class="brand-lockup">
  <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
    <g class="brand-mark__orbit">
      <ellipse cx="32" cy="32" rx="25" ry="9" transform="rotate(30 32 32)"></ellipse>
      <ellipse cx="32" cy="32" rx="25" ry="9" transform="rotate(-30 32 32)"></ellipse>
      <ellipse cx="32" cy="32" rx="25" ry="9" transform="rotate(90 32 32)"></ellipse>
    </g>
    <circle class="brand-mark__nucleus" cx="32" cy="32" r="7"></circle>
    <path class="brand-mark__earth" d="M27 31c4-4 7-2 10-5M27 35c4-2 7 3 11 0"></path>
    <g class="brand-mark__electron">
      <circle cx="11" cy="20" r="2.5"></circle><circle cx="53" cy="44" r="2.5"></circle>
      <circle cx="12" cy="45" r="2.5"></circle><circle cx="52" cy="19" r="2.5"></circle>
      <circle cx="32" cy="7" r="2.5"></circle><circle cx="32" cy="57" r="2.5"></circle>
    </g>
  </svg>
  {!compact && <span class="brand-wordmark">Atoms for Humanity</span>}
</span>

<style>
  .brand-lockup { display: inline-flex; align-items: center; gap: .75rem; color: var(--text-primary); }
  .brand-mark { width: 2rem; height: 2rem; flex: none; overflow: visible; }
  .brand-mark__orbit { fill: none; stroke: var(--text-secondary); stroke-width: 1.65; }
  .brand-mark__nucleus, .brand-mark__electron { fill: var(--accent); }
  .brand-mark__earth { fill: none; stroke: var(--bg-primary); stroke-width: 1.4; stroke-linecap: round; }
  .brand-wordmark { font-weight: 540; letter-spacing: -.025em; font-size: 1rem; white-space: nowrap; }
</style>
