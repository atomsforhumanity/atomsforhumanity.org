---
import type { Project } from "../data/projects";
interface Props { project: Project; featured?: boolean; }
const { project, featured = false } = Astro.props;
---

<article class:list={["project-card", { "project-card--featured": featured }]}>
  <p class="project-category">{project.category}</p>
  <h3><span class="project-prompt" aria-hidden="true">›</span>{project.name}</h3>
  <p>{project.description}</p>
  {project.supportingLine && <p class="supporting-line">{project.supportingLine}</p>}
  <div class="project-links">
    {project.repository && <a href={project.repository} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>}
    {project.documentation && <a href={project.documentation} target="_blank" rel="noopener noreferrer">Documentation <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>}
    {project.links?.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>)}
  </div>
</article>

<style>
  .project-card { display: flex; flex-direction: column; padding: 2rem 0; border-top: 1px solid var(--border-strong); }
  .project-category { margin: 0 0 1.2rem; color: var(--text-muted); font: 600 .75rem/1.4 var(--font-sans); letter-spacing: .065em; }
  .project-card h3 { margin: 0 0 1rem; font: 600 clamp(1.5rem, 2vw, 1.85rem)/1.2 var(--font-sans); letter-spacing: -.025em; }
  .project-prompt { display: none; }
  .project-card > p:not(.project-category) { margin: 0; color: var(--text-secondary); font-size: 1.06rem; }
  .supporting-line { margin-top: 1rem !important; color: var(--text-primary) !important; }
  .project-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: auto; padding-top: 1.6rem; }
  .project-links a { color: var(--blue-dark); font-size: 1rem; font-weight: 600; }
  .project-card--featured { padding: clamp(1.5rem, 3vw, 2.5rem); background: var(--bg-secondary); border-bottom: 1px solid var(--border); }
</style>
