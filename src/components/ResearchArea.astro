---
import type { ResearchArea as ResearchAreaType } from "../data/research";
interface Props { area: ResearchAreaType; concise?: boolean; }
const { area, concise = false } = Astro.props;
---

<article class="research-area">
  <p class="research-index">{area.index}</p>
  <div>
    <p class="research-name">{area.shortTitle}</p>
    <h3>{concise ? area.shortTitle : area.title}</h3>
    <p>{area.description}</p>
  </div>
</article>

<style>
  .research-area { display: grid; grid-template-columns: 54px 1fr; gap: clamp(1rem, 3vw, 2.5rem); padding: 2.2rem 0; border-top: 1px solid var(--border-dark); }
  .research-index { margin: .15rem 0 0; color: var(--accent); font: 500 .76rem/1.5 var(--font-mono); }
  .research-name { margin: 0 0 .65rem; color: var(--text-muted); font: 500 .72rem/1.4 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .research-area h3 { margin: 0; max-width: 750px; font-size: clamp(1.5rem, 2.5vw, 2.15rem); }
  .research-area div > p:last-child { max-width: 760px; margin: 1rem 0 0; color: var(--text-secondary); }
  @media (max-width: 520px) { .research-area { grid-template-columns: 1fr; gap: .5rem; } }
</style>
