---
import Logo from "./Logo.astro";
import { navigation, organization } from "../data/organization";
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" aria-label="Atoms for Humanity home"><Logo /></a>
      <p>{organization.mission}</p>
    </div>
    <div class="footer-column">
      <h2>Explore</h2>
      <ul>
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/donate">Make a Donation</a></li>
      </ul>
    </div>
    <div class="footer-column">
      <h2>Connect</h2>
      <ul>
        <li><a href={organization.links.github}>GitHub <span aria-hidden="true">↗</span></a></li>
        <li><a href={organization.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></li>
      </ul>
    </div>
    <div class="footer-column footer-identity">
      <h2>{organization.legalName}</h2>
      <p>{organization.type}<br />EIN {organization.ein}</p>
      <address>
        {organization.address.street}<br />
        {organization.address.city}, {organization.address.state} {organization.address.postalCode}<br />
        {organization.address.country}
      </address>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© 2026 Atoms for Humanity</p>
    <p>Building scientific infrastructure for a sustainable molecular future.</p>
  </div>
</footer>

<style>
  .site-footer { padding: clamp(4rem, 8vw, 7rem) 0 1.5rem; background: #080d0c; border-top: 1px solid var(--border-dark); }
  .footer-main { display: grid; grid-template-columns: minmax(260px, 2fr) repeat(3, minmax(130px, 1fr)); gap: clamp(2rem, 5vw, 5rem); }
  .footer-brand a { text-decoration: none; }
  .footer-brand p { max-width: 340px; margin: 1.4rem 0 0; color: var(--text-secondary); font-size: 1rem; }
  .footer-column h2 { margin: .25rem 0 1rem; font: 540 .74rem/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); }
  .footer-column ul { list-style: none; padding: 0; margin: 0; }
  .footer-column li + li { margin-top: .65rem; }
  .footer-column a { color: var(--text-secondary); text-decoration: none; font-size: .93rem; }
  .footer-column a:hover { color: var(--accent); }
  .footer-identity p, .footer-identity address { margin: 0; color: var(--text-secondary); font-size: .9rem; line-height: 1.65; font-style: normal; }
  .footer-identity address { margin-top: .8rem; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 2rem; margin-top: clamp(3rem, 7vw, 6rem); padding-top: 1.25rem; border-top: 1px solid var(--border-dark); color: var(--text-muted); font-size: .77rem; }
  .footer-bottom p { margin: 0; }
  @media (max-width: 850px) { .footer-main { grid-template-columns: 1.5fr 1fr 1fr; }.footer-identity { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .footer-main { grid-template-columns: 1fr 1fr; }.footer-brand, .footer-identity { grid-column: 1 / -1; }.footer-bottom { flex-direction: column; gap: .5rem; } }
</style>
