---
const steps = ["Hypothesize", "Simulate", "Analyze", "Learn", "Choose the next experiment"];
---

<figure class="lab-loop">
  <div class="loop-track" aria-label="Digital chemical laboratory cycle">
    {steps.map((step, index) => (
      <div class:list={["loop-step", { "loop-step--wide": index === steps.length - 1 }]}>
        <span class="loop-index">0{index + 1}</span>
        <strong>{step}</strong>
        {index < steps.length - 1 && <span class="loop-arrow" aria-hidden="true">↓</span>}
      </div>
    ))}
    <svg class="loop-return" viewBox="0 0 150 270" aria-hidden="true">
      <path d="M18 248c96 0 114-46 114-107S111 24 34 24"></path>
      <path d="m43 15-13 9 13 9"></path>
    </svg>
  </div>
  <figcaption>Each result informs the next computational experiment.</figcaption>
</figure>

<style>
  .lab-loop { margin: 0; padding: clamp(1.4rem, 3vw, 2.5rem); background: var(--bg-primary); border: 1px solid var(--border-dark); border-radius: var(--radius-md); }
  .loop-track { position: relative; width: min(100%, 440px); }
  .loop-step { position: relative; display: grid; grid-template-columns: 42px 1fr; align-items: center; min-height: 54px; padding: .7rem 4rem .7rem 0; border-top: 1px solid var(--border-dark); }
  .loop-step:first-child { border-top: 0; }
  .loop-index { color: var(--accent); font: 500 .66rem/1 var(--font-mono); }
  .loop-step strong { font-weight: 500; letter-spacing: -.02em; }
  .loop-arrow { position: absolute; inset: auto 1.15rem -.75rem auto; z-index: 1; color: var(--text-muted); font: 400 1rem/1 var(--font-mono); }
  .loop-return { position: absolute; width: 108px; height: calc(100% - 30px); inset: 15px -20px auto auto; overflow: visible; }
  .loop-return path { fill: none; stroke: rgba(66,221,177,.35); stroke-width: 1.3; }
  figcaption { margin-top: 1.3rem; color: var(--text-muted); font: 450 .69rem/1.4 var(--font-mono); }
</style>
