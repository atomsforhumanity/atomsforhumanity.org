---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { TeamMember as TeamMemberType } from "../data/team";
interface Props { member: TeamMemberType; }
const { member } = Astro.props;
const hasImage = existsSync(join(process.cwd(), "public", member.image));
---

<article class="person-card">
  <div class="portrait">
    {hasImage ? (
      <img src={member.image} alt={`Portrait of ${member.name}`} width="660" height="825" loading="lazy" decoding="async" />
    ) : (
      <div class="portrait-placeholder" role="img" aria-label={`Portrait placeholder for ${member.name}`}>
        <span class="portrait-initials">{member.initials}</span>
        <span class="portrait-status">PORTRAIT FORTHCOMING</span>
      </div>
    )}
  </div>
  <div class="person-copy">
    <h3>{member.name}</h3>
    <p class="person-title">{member.title}</p>
    <p>{member.bio}</p>
    {member.links && <div class="person-links">{member.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>)}</div>}
  </div>
</article>

<style>
  .person-card { display: grid; grid-template-columns: minmax(200px, .7fr) minmax(0, 1.5fr); border-top: 1px solid var(--border); padding: 3rem 0; gap: clamp(2rem, 6vw, 6rem); }
  .portrait { aspect-ratio: 4 / 5; max-width: 300px; background: var(--bg-blue-soft); border-radius: var(--radius-sm); overflow: hidden; }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .portrait-placeholder { position: relative; display: grid; place-items: center; height: 100%; background: var(--bg-blue-soft); }
  .portrait-initials { color: var(--blue-dark); font: 450 clamp(2rem, 4vw, 3.5rem)/1 var(--font-serif); }
  .portrait-status { position: absolute; inset: auto 1rem 1rem; color: var(--text-muted); font: 500 .72rem/1.4 var(--font-sans); letter-spacing: .06em; }
  .person-copy { align-self: center; max-width: 710px; }
  .person-copy h3 { margin: 0; font-size: clamp(1.75rem, 3vw, 2.35rem); font-weight: 550; }
  .person-title { margin: .6rem 0 1.4rem; color: var(--blue-primary); font: 600 1rem/1.5 var(--font-sans); }
  .person-copy > p:last-of-type { margin: 0; color: var(--text-secondary); font-size: 1.1rem; }
  .person-links { display: flex; gap: 1.5rem; margin-top: 1.5rem; }
  .person-links a { font-size: 1rem; }
  @media (max-width: 680px) { .person-card { grid-template-columns: 1fr; gap: 1.8rem; }.portrait { width: min(100%, 280px); }.person-copy { align-self: start; } }
</style>
