---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { organization } from "../data/organization";
import { themes, DEFAULT_THEME_ID, THEME_VAR_KEYS, STORAGE_KEYS } from "../data/themes";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = "/social-card.png", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, organization.domain).toString();
const socialImage = new URL(image, organization.domain).toString();
const socialImageType = image.endsWith(".png") ? "image/png" : image.endsWith(".jpg") || image.endsWith(".jpeg") ? "image/jpeg" : undefined;
const socialImageAlt = "Atoms for Humanity — Building a sustainable molecular future.";
const schema = {
  "@context": "https://schema.org",
  "@type": "NonprofitOrganization",
  name: organization.name,
  legalName: organization.legalName,
  url: organization.domain,
  logo: `${organization.domain}/favicon.svg`,
  description: organization.shortDescription,
  taxID: organization.ein,
  foundingDate: organization.foundingDate,
  nonprofitStatus: "https://schema.org/Nonprofit501c3",
  address: {
    "@type": "PostalAddress",
    streetAddress: organization.address.street,
    addressLocality: organization.address.city,
    addressRegion: organization.address.state,
    postalCode: organization.address.postalCode,
    addressCountry: "US",
  },
  sameAs: [organization.links.github, organization.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0B1110" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={organization.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <title>{title}</title>
    <script
      is:inline
      define:vars={{
        builtInThemes: themes,
        allThemeVarKeys: THEME_VAR_KEYS,
        defaultThemeId: DEFAULT_THEME_ID,
        activeThemeKey: STORAGE_KEYS.activeTheme,
        customPalettesKey: STORAGE_KEYS.customPalettes,
      }}
    >
      (function () {
        var customPalettes = [];
        try {
          customPalettes = JSON.parse(localStorage.getItem(customPalettesKey) || "[]");
          if (!Array.isArray(customPalettes)) customPalettes = [];
        } catch (e) {
          customPalettes = [];
        }
        // Merged, mutable working list: built-in themes from source, plus
        // whatever the user has saved locally via the palette editor.
        var allThemes = builtInThemes.concat(customPalettes);

        function findTheme(id) {
          for (var i = 0; i < allThemes.length; i++) {
            if (allThemes[i].id === id) return allThemes[i];
          }
          return null;
        }

        function persistCustomPalettes() {
          try {
            localStorage.setItem(customPalettesKey, JSON.stringify(customPalettes));
          } catch (e) {}
        }

        function apply(id) {
          var theme = findTheme(id) || allThemes[0];
          var root = document.documentElement;
          for (var j = 0; j < allThemeVarKeys.length; j++) {
            root.style.removeProperty("--" + allThemeVarKeys[j]);
          }
          if (theme.vars) {
            for (var key in theme.vars) {
              root.style.setProperty("--" + key, theme.vars[key]);
            }
          }
          root.setAttribute("data-theme", theme.id);
          if (theme.fontLinks) {
            theme.fontLinks.forEach(function (href) {
              if (href && !document.querySelector('link[data-theme-font="' + href + '"]')) {
                var link = document.createElement("link");
                link.rel = "stylesheet";
                link.href = href;
                link.setAttribute("data-theme-font", href);
                document.head.appendChild(link);
              }
            });
          }
          try {
            localStorage.setItem(activeThemeKey, theme.id);
          } catch (e) {}
        }

        window.__afhApplyTheme = apply;
        window.__afhGetThemes = function () {
          return allThemes.slice();
        };
        window.__afhAddCustomTheme = function (theme) {
          customPalettes.push(theme);
          allThemes.push(theme);
          persistCustomPalettes();
        };
        window.__afhRemoveCustomTheme = function (id) {
          customPalettes = customPalettes.filter(function (t) {
            return t.id !== id;
          });
          allThemes = builtInThemes.concat(customPalettes);
          persistCustomPalettes();
        };
        window.__afhIsCustomTheme = function (id) {
          for (var i = 0; i < customPalettes.length; i++) {
            if (customPalettes[i].id === id) return true;
          }
          return false;
        };

        var saved = defaultThemeId;
        try {
          saved = localStorage.getItem(activeThemeKey) || defaultThemeId;
        } catch (e) {}
        apply(saved);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <ThemeSwitcher />
  </body>
</html>
