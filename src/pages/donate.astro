---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Support Atoms for Humanity" description="Support Atoms for Humanity's open scientific infrastructure and research toward a sustainable molecular future.">
  <section class="donate-page">
    <div class="container donate-grid">
      <div class="donate-copy">
        <p class="eyebrow">SUPPORT THE MISSION</p>
        <h1>Support a sustainable molecular future.</h1>
        <div class="lede">
          <p>Donations to Atoms for Humanity support open scientific infrastructure and research designed to expand humanity's ability to discover better chemistry.</p>
          <p>We are preparing our online donation system now.</p>
        </div>
        <div class="link-row"><a class="text-link" href="/work">Explore our work <span aria-hidden="true">→</span></a><a class="text-link" href="/organization">Learn about the organization <span aria-hidden="true">→</span></a></div>
      </div>
      <aside class="donate-status">
        <div class="status-top"><span class="status-dot" aria-hidden="true"></span><span>DONATION SYSTEM / IN PREPARATION</span></div>
        <div class="status-main"><p>Online donations are coming soon.</p><span>Thank you for your interest in supporting our work.</span></div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .donate-page { display: grid; align-items: center; padding: clamp(4.5rem, 9vw, 8rem) 0; }
  .donate-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: center; gap: clamp(3rem, 7vw, 7rem); }
  .donate-copy h1 { max-width: 800px; margin: 1rem 0 0; font-size: clamp(3rem, 6vw, 5.5rem); }
  .donate-copy .lede p { margin: 0; }
  .donate-copy .lede p + p { margin-top: 1rem; }
  .donate-status { display: flex; flex-direction: column; gap: 3rem; padding: 2rem 0; border-block: 1px solid var(--border-strong); }
  .status-top { display: flex; align-items: center; gap: .65rem; color: var(--text-muted); font: 600 .75rem/1.4 var(--font-sans); letter-spacing: .05em; }
  .status-dot { width: 6px; height: 6px; flex: none; background: var(--green-muted); border-radius: 50%; }
  .status-main p { margin: 0; color: var(--text-heading); font: 450 clamp(1.8rem, 3vw, 2.5rem)/1.2 var(--font-serif); letter-spacing: -.025em; }
  .status-main span { display: block; margin-top: 1rem; color: var(--text-secondary); }
  @media (max-width: 820px) { .donate-grid { grid-template-columns: 1fr; }.donate-status { max-width: 600px; } }
</style>
