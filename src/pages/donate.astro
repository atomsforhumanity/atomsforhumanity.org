---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Support Atoms for Humanity" description="Support Atoms for Humanity's open scientific infrastructure and research toward a sustainable molecular future.">
  <section class="donate-page">
    <div class="container donate-grid">
      <div class="donate-copy">
        <p class="eyebrow">SUPPORT THE MISSION</p>
        <h1>Support a sustainable molecular future.</h1>
        <div class="lede">
          <p>Donations to Atoms for Humanity support open scientific infrastructure and research designed to expand humanity's ability to discover better chemistry.</p>
          <p>We are preparing our online donation system now.</p>
        </div>
        <div class="link-row"><a class="text-link" href="/work">Explore our work <span aria-hidden="true">→</span></a><a class="text-link" href="/organization">Learn about the organization <span aria-hidden="true">→</span></a></div>
      </div>
      <aside class="donate-status">
        <div class="status-top"><span class="status-dot" aria-hidden="true"></span><span>DONATION SYSTEM / IN PREPARATION</span></div>
        <div class="status-main"><p>Online donations are coming soon.</p><span>Thank you for your interest in supporting our work.</span></div>
        <svg viewBox="0 0 400 140" aria-hidden="true"><path d="M15 108c71 0 78-80 153-80s82 86 148 86 47-67 78-67"/><circle cx="168" cy="28" r="5"/><circle cx="316" cy="114" r="5"/></svg>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .donate-page { min-height: calc(100svh - var(--header-height)); display: grid; align-items: center; padding: clamp(5rem, 10vw, 9rem) 0; }
  .donate-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(360px, .85fr); align-items: center; gap: clamp(3rem, 9vw, 9rem); }.donate-copy h1 { max-width: 800px; margin: 1rem 0 0; font-size: clamp(3.1rem, 6.5vw, 5.8rem); }.donate-copy .lede p { margin: 0; }.donate-copy .lede p + p { margin-top: 1rem; }
  .donate-status { min-height: 430px; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--bg-elevated); border: 1px solid var(--border-dark); border-radius: var(--radius-md); overflow: hidden; }.status-top { display: flex; align-items: center; gap: .65rem; color: var(--text-muted); font: 500 .61rem/1.2 var(--font-mono); letter-spacing: .08em; }.status-dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 0 5px rgba(66,221,177,.08); }.status-main { margin-top: auto; }.status-main p { margin: 0; color: var(--text-primary); font-size: clamp(1.65rem, 3vw, 2.4rem); font-weight: 520; line-height: 1.15; letter-spacing: -.04em; }.status-main span { display: block; margin-top: 1rem; color: var(--text-secondary); }.donate-status svg { margin: 1.5rem -2.5rem -2.5rem; width: calc(100% + 5rem); }.donate-status path { fill: none; stroke: rgba(66,221,177,.24); }.donate-status circle { fill: var(--bg-elevated); stroke: var(--accent-muted); }
  @media (max-width: 820px) { .donate-grid { grid-template-columns: 1fr; }.donate-status { min-height: 350px; } }
</style>
